# Browser requests always use /api/v1 on the website domain.
# Vercel upstream is configured in vercel.json; this optional value is for local preview/dev only.
NEXT_PUBLIC_API_URL=
FARMTRY_API_UPSTREAM=
# Relative path under NEXT_PUBLIC_API_URL, supplied by the backend owner for multipart KYC submission.
# The current frontend target is /aggregator/kyc; override if the backend uses another route.
NEXT_PUBLIC_AGGREGATOR_KYC_SUBMIT_PATH=

# Override registration routes only if the deployed backend uses different paths.
NEXT_PUBLIC_CONSUMER_REGISTER_PATH=
NEXT_PUBLIC_CORPORATE_REGISTER_PATH=
NEXT_PUBLIC_AGGREGATOR_REGISTER_PATH=

# Account/settings update targets; backend responses provide validation and permission errors.
NEXT_PUBLIC_BUYER_PROFILE_UPDATE_PATH=
NEXT_PUBLIC_ADMIN_SETTINGS_PATH=
